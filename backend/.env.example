# ReachInbox Email Scheduler Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database
# For SQLite local development:
DATABASE_URL="file:./dev.db"
# For PostgreSQL with Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# Redis (BullMQ persistent queue backend)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ Configuration
EMAIL_QUEUE_NAME=reachinbox-email-queue
WORKER_CONCURRENCY=5

# Scheduler Throughput & Rate Limiting Defaults
DEFAULT_DELAY_BETWEEN_EMAILS_SECONDS=2
DEFAULT_MAX_EMAILS_PER_HOUR=20

# Elasticsearch (searchable sent & scheduled emails)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# Slack Integration (OAuth or Incoming Webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth/callback
SLACK_WEBHOOK_URL=

# Ethereal Email Credentials (auto-generated if empty)
ETHEREAL_USER=
ETHEREAL_PASS=
